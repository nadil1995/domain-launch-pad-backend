# PostgreSQL (Railway)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@your-host.railway.app:PORT/railway

# AWS S3 (optional — leave blank to skip S3 uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
S3_BUCKET=

# Scraper settings
SCRAPER_DELAY_SECONDS=1.5
SCRAPER_MAX_PAGES=10
